# Placed on the VPS as /opt/tokunoshima-flight-info/.env.production (docs/deploy.md).
# This example may be committed; a filled-in copy must never be.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Compose reads this file for ${...}: write a literal $ as $$ and quote values
# that contain spaces.

# The image to run. Use a commit SHA tag, not latest.
APP_IMAGE=ghcr.io/yanchi/tokunoshima-flight-info:<commit-sha>

# Host port for the host nginx to proxy to. Pick one that is free on the VPS.
APP_PORT=8003

# openssl rand -hex 32
APP_SECRET=

# Contact form. Neither address is shown on any page.
CONTACT_RECIPIENT=
CONTACT_FROM=
# smtp://user:password@host:587 (@ as %40, URL-encode symbols in the password)
MAILER_DSN=

# Leave empty until the timetable gate decision (docs/data-source-verification.md §7 step 6).
ODPT_CONSUMER_KEY=
