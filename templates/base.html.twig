<!DOCTYPE html>
<html lang="ja">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}徳之島空港 発着案内（非公式）{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>✈️</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="/styles/app.css">
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {# Dev only: never load third-party scripts in production even if the variable leaks in. #}
        {% set frankenphp_hot_reload = app.environment == 'dev' ? app.request.server.get('FRANKENPHP_HOT_RELOAD') : null %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <header class="site-header">
            <p class="site-name">
                <a href="{{ path('board_today') }}"><span class="site-name-icon" aria-hidden="true">✈</span>徳之島空港 発着案内<span class="site-name-note">（非公式）</span></a>
            </p>
            <p class="sibling-link"><a href="https://ship.isl-mentor.com/">フェリーの運航情報はこちら</a></p>
        </header>
        <main class="site-main">
            {% if app.request.attributes.get('_route') != 'board_today' %}
                <p class="back-link"><a href="{{ path('board_today') }}">← 本日の発着便に戻る</a></p>
            {% endif %}
            {% block body %}{% endblock %}
        </main>
        <footer class="site-footer">
            {{ include('_official_notice.html.twig') }}
            <p>本サイトは航空会社とは関係のない非公式サイトです。</p>
            <nav class="footer-nav" aria-label="サイト情報">
                <ul>
                    <li><a href="{{ path('board_today') }}">本日の発着便</a></li>
                    <li><a href="{{ path('info_about') }}">このサイトについて</a></li>
                    <li><a href="{{ path('info_sources') }}">データの出典</a></li>
                </ul>
            </nav>
        </footer>
    </body>
</html>
