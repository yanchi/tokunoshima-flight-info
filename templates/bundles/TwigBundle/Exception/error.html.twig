{# Every error status uses this one template (docs/data-source-verification.md §8 「エラーの画面」).
   Never print `exception`: its message and trace must not reach the page. #}
{% extends 'base.html.twig' %}

{% if status_code == 400 %}
    {% set error_heading = '指定が正しくありません' %}
    {% set error_lines = [
        '表示する日付、または出発・到着の指定が正しくありません。',
        '日付は、半角の数字で「年-月-日」の形（例：2026-11-17）で指定してください。',
    ] %}
{% elseif status_code == 404 %}
    {% set error_heading = 'ページが見つかりません' %}
    {% set error_lines = [
        'お探しのページは見つかりませんでした。URL をご確認ください。',
    ] %}
{% elseif status_code >= 400 and status_code < 500 %}
    {% set error_heading = 'ページを表示できません' %}
    {% set error_lines = [
        'このページは表示できません。',
    ] %}
{% else %}
    {% set error_heading = 'ページを表示できません' %}
    {% set error_lines = [
        'サーバーで問題が起きたため、ページを表示できませんでした。時間をおいて、もう一度お試しください。',
    ] %}
{% endif %}

{% block title %}{{ error_heading }} | {{ parent() }}{% endblock %}

{% block body %}
    <h1>{{ error_heading }}</h1>
    <section class="error-message">
        {% for line in error_lines %}
            <p>{{ line }}</p>
        {% endfor %}
        <p>{{ include('_official_status_sentence.html.twig')|trim }}</p>
        <p class="error-code">エラーコード：{{ status_code }}</p>
    </section>
{% endblock %}
